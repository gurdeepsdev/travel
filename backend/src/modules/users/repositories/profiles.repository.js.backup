import BaseRepository from "../../../database/repositories/base.repository.js";

class ProfilesRepository extends BaseRepository {

    constructor() {

        super("users", "profiles");

    }

    async create({

    userId,

    username,

    displayName = null,

    bio = null,

    profilePhotoAssetId = null,

    coverPhotoAssetId = null,

    countryId = null,

    cityId = null,

    socialLinks = {}

}) {

    const query = `
        INSERT INTO ${this.fullTableName}
        (
            user_id,
            username,
            display_name,
            bio,
            profile_photo_asset_id,
            cover_photo_asset_id,
            country_id,
            city_id,
            social_links
        )
        VALUES
        (
            $1,
            $2,
            $3,
            $4,
            $5,
            $6,
            $7,
            $8,
            $9
        )
        RETURNING *
    `;

    const { rows } = await this.query(query, [

        userId,

        username,

        displayName,

        bio,

        profilePhotoAssetId,

        coverPhotoAssetId,

        countryId,

        cityId,

        socialLinks

    ]);

    return rows[0];

}

    async findByUserId(userId) {

    return this.findOne(

        "user_id = $1 AND deleted_at IS NULL",

        [userId]

    );

}
}

export default new ProfilesRepository();
