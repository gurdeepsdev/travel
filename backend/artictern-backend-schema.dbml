Table users.visited_places {
  Note: '''
  Verified user visits to canonical places. Historical gallery photos are retained as private verification evidence.

  verification_status: PENDING, VERIFIED, or REJECTED.
  visit_source: MANUAL, TRIP_COMPLETION, PHOTO_VERIFICATION, or ADMIN.
  Exact evidence reuse is prevented by a partial unique SHA-256 index.
  '''
  id uuid [pk, not null, default: `gen_random_uuid()`]
  user_id uuid [not null, note: 'User whose visit was recorded.']
  place_id uuid [not null, note: 'Canonical verified POI.']
  trip_id uuid [note: 'Optional trip associated with the visit.']
  verification_asset_id uuid [note: 'Private uploaded photo used only as verification evidence.']
  verification_status varchar(20) [not null, default: 'PENDING', note: 'PENDING, VERIFIED, or REJECTED.']
  visit_source varchar(30) [not null, default: 'MANUAL', note: 'MANUAL, TRIP_COMPLETION, PHOTO_VERIFICATION, or ADMIN.']
  visited_at timestamptz [not null, default: `CURRENT_TIMESTAMP`, note: 'Verified visit time stored as an absolute timestamp.']
  created_at timestamptz [not null, default: `CURRENT_TIMESTAMP`, note: 'Creation time stored as an absolute timestamp.']
  updated_at timestamptz [not null, default: `CURRENT_TIMESTAMP`, note: 'Most recent update time stored as an absolute timestamp.']
  collections_id uuid [not null, note: 'Verified city collection created or reused for this visit.']
  claimed_visited_at timestamptz [note: 'Optional historical visit time claimed by the user.']
  evidence_captured_at timestamptz [note: 'Capture time extracted from image EXIF metadata.']
  evidence_latitude double [note: 'EXIF latitude; when present it must be between -90 and 90.']
  evidence_longitude double [note: 'EXIF longitude; when present it must be between -180 and 180.']
  evidence_sha256 varchar(64) [note: 'Lowercase SHA-256 digest used for exact duplicate detection.']
  evidence_perceptual_hash varchar(128) [note: 'Perceptual image hash reserved for near-duplicate detection.']
  verification_details jsonb [not null, default: `'{}'::jsonb`, note: 'Internal verification result details stored as a JSON object.']

  indexes {
    (user_id, place_id) [unique, name: 'uq_user_place_visit']
    (user_id, place_id, collections_id) [unique, name: 'uq_users_visited_places_user_place_collection', note: 'PostgreSQL index is partial where collections_id IS NOT NULL.']
    (evidence_sha256) [unique, name: 'uq_visited_places_evidence_sha256', note: 'PostgreSQL index is partial where evidence_sha256 IS NOT NULL.']
    (evidence_perceptual_hash) [name: 'idx_visited_places_evidence_perceptual_hash', note: 'PostgreSQL index is partial where evidence_perceptual_hash IS NOT NULL.']
    (user_id, visited_at, id) [name: 'idx_visited_places_user_visited_id', note: 'PostgreSQL uses visited_at DESC and id DESC.']
  }
}

Table users.collection {
  Note: '''
  One verified-city collection per user and city. A verified place verifies its containing city.

  Only verified collections can be preferred, and a trigger limits each user to five preferred cities.
  The canonical display icon comes from poi.cities.icon_asset_id; verification evidence is never used as the city icon.
  '''
  id uuid [pk, not null, default: `gen_random_uuid()`]
  user_id uuid [not null, note: 'User who owns the verified-city collection.']
  collections_name varchar(50) [not null, note: 'Presentation name, normally the canonical city name.']
  icon_asset_id uuid [note: 'Legacy collection icon field; profile display uses poi.cities.icon_asset_id.']
  verification_asset_id uuid [note: 'Private evidence asset associated with verification; never exposed as the city icon.']
  verification_status bool [not null, default: false]
  visited_at timestamptz [note: 'Verified city visit time.']
  is_preference bool [not null, default: false, note: 'Whether this verified city is one of the maximum five shown on the profile.']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  city_id uuid [not null, note: 'Canonical city verified for this collection.']

  indexes {
    (user_id, city_id) [unique, name: 'uq_users_collection_user_city']
    (city_id) [name: 'idx_users_collection_city']
    (user_id, is_preference) [name: 'idx_users_collection_user_preference']
    (visited_at) [name: 'idx_users_collection_visited_at', note: 'PostgreSQL uses visited_at DESC.']
  }
}

