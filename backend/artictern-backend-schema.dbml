Table poi.countries {
  Note: 'Canonical list of countries available to the POI and profile domains.'
  id uuid [pk, not null, note: 'Primary identifier. Filled by: server-generated UUID.']
  name varchar(50) [not null, note: 'Country display name.']
  code varchar(50) [not null, unique, note: 'Unique country code, preferably ISO 3166-1 alpha-2 or alpha-3.']
  phone_prefix varchar(10) [note: 'International calling prefix, for example +91.']
  currency_id uuid [note: 'Currency used by the country. FK target must be added when a currency table is available.']
  timezone varchar(10) [note: 'Country timezone identifier. Consider increasing this length for IANA values such as America/Argentina/Buenos_Aires.']
  flag_asset_id uuid [note: 'Flag image stored in media.assets.']
  is_active bool [not null, default: true, note: 'Whether the country is selectable in the application.']
  description varchar(500) [note: 'Country description. Source column was spelled descreption.']
  created_at timestamptz [not null, note: 'Creation audit timestamptz. Filled by: auto.']
  updated_at timestamptz [note: 'Most recent update audit timestamptz. Filled by: auto.']
}

Table poi.regions {
  Note: 'Administrative regions or states belonging to a country.'
  id uuid [pk, not null, note: 'Primary identifier. Filled by: server-generated UUID.']
  country_id uuid [not null, note: 'Country containing this region.']
  name varchar(50) [not null, note: 'Region display name.']
  official_name varchar(100) [note: 'Official or legal name of the region.']
  longitude float [note: 'Representative longitude coordinate.']
  latitude float [note: 'Representative latitude coordinate. Source column was spelled lattitude.']
  description varchar(500) [note: 'Region description.']
  timezone varchar(10) [note: 'Region timezone identifier. Consider increasing this length for IANA timezone values.']
  is_active bool [not null, default: true, note: 'Whether the region is selectable in the application.']
  created_at timestamptz [not null, note: 'Creation audit timestamptz. Filled by: auto.']
  updated_at timestamptz [note: 'Most recent update audit timestamptz. Filled by: auto.']
}

Table poi.cities {
  Note: 'Cities belonging to a region and country.'
  id uuid [pk, not null, note: 'Primary identifier. Filled by: server-generated UUID.']
  region_id uuid [not null, note: 'Region containing this city.']
  country_id uuid [not null, note: 'Country containing this city.']
  name varchar(50) [not null, note: 'City display name.']
  official_name varchar(100) [note: 'Official or legal name of the city.']
  longitude float [note: 'Representative longitude coordinate.']
  latitude float [note: 'Representative latitude coordinate. Source column was spelled lattitude.']
  is_active bool [not null, default: true, note: 'Whether the city is selectable in the application.']
  icon_asset_id uuid [note: 'Canonical public icon displayed for this city in verified-city collections and profile preferences.']
  created_at timestamptz [not null, note: 'Creation audit timestamptz. Filled by: auto.']
  updated_at timestamptz [note: 'Most recent update audit timestamptz. Filled by: auto.']

