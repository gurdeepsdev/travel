  caption varchar(250) [note: 'Human-readable caption explaining this posts. Filled by: api.']
  post_type varchar(50) [note: 'Selects the supported post variant. Filled by: api. Source says mandatory=default; define nullability and the actual default separately.']
  visibility varchar(50) [note: 'Audience permitted to discover or view the record. Filled by: api. Source says mandatory=default; define nullability and the actual default separately.']
  place_id uuid [not null, note: 'Canonical place or POI supplied by the place-data subsystem. Filled by: api. FK target is missing in the source and must be resolved.']
  comment_count bigint [note: 'Cached comment aggregate for fast feed rendering. Filled by: api. Source says mandatory=default; define nullability and the actual default separately.']
  share_count bigint [note: 'Cached share aggregate for engagement display. Filled by: api. Source says mandatory=default; define nullability and the actual default separately.']
  view_count bigint [note: 'Cached view aggregate for reach and ranking. Filled by: api. Source says mandatory=default; define nullability and the actual default separately.']
  created_at timestamptztz [not null, note: 'Creation audit timestamptztz. Filled by: auto. Recommendation: use timestamptztztz and ISO-8601 API values with timezone.']
  updated_at timestamptztz [note: 'Most recent update audit timestamptztz. Filled by: auto. Recommendation: use timestamptztztz and ISO-8601 API values with timezone.']
}

Table explore.post_tagged_users {
