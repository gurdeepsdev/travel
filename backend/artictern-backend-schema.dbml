Table chat.conversations {
  Note: 'Message thread supporting both direct one-to-one conversations and group conversations.'

  id uuid [
    pk,
    not null,
    note: 'Primary identifier. Filled by: server-generated UUID.'
  ]

  group_id uuid [
    null,
    note: 'Group associated with the conversation. Required for group conversations and null for direct conversations.'
  ]

  last_message_id uuid [
    null,
    note: 'Cached reference to the newest message for conversation-list previews.'
  ]

  conversation_type varchar(20) [
    not null,
    default: 'group',
    note: 'Conversation type. Allowed values: direct, group.'
  ]

  direct_key varchar(100) [
    null,
    unique,
    note: 'Stable sorted combination of the two user UUIDs for direct conversations. Null for group conversations. Example: smaller_user_uuid:larger_user_uuid.'
  ]

  created_at timestamp [
    not null,
    default: `CURRENT_TIMESTAMP`,
    note: 'Creation timestamp.'
  ]

  updated_at timestamp [
    not null,
    default: `CURRENT_TIMESTAMP`,
    note: 'Most recent update timestamp.'
  ]

  deleted_at timestamp [
    null,
    note: 'Soft-delete timestamp. Null while active.'
  ]

  indexes {
    conversation_type [name: 'idx_conversations_type']
    created_at [name: 'idx_conversations_created_at']
    updated_at [name: 'idx_conversations_updated_at']
    deleted_at [name: 'idx_conversations_deleted_at']
    last_message_id [name: 'idx_conversations_last_message']
    group_id [name: 'idx_conversations_group']
  }
}

Table chat.conversation_participants {
  Note: 'Users participating in direct or group conversations, including read, mute, archive, join and leave state.'

  id uuid [
    pk,
    not null,
    note: 'Primary identifier. Filled by: server-generated UUID.'
  ]

  conversation_id uuid [
    not null,
    note: 'Conversation in which the user participates.'
  ]

  user_id uuid [
    not null,
    note: 'User participating in the conversation.'
  ]

  role varchar(20) [
    not null,
    default: 'member',
    note: 'Participant role. Allowed values: owner, admin, member.'
  ]

  joined_at timestamp [
    not null,
    default: `CURRENT_TIMESTAMP`,
    note: 'Timestamp when the user joined the conversation.'
  ]

  left_at timestamp [
    null,
    note: 'Timestamp when the user left the conversation. Null while actively participating.'
  ]

  last_read_message_id uuid [
    null,
    note: 'Latest message read by this participant.'
  ]

  last_read_at timestamp [
    null,
    note: 'Timestamp when the participant last read the conversation.'
  ]

  is_muted bool [
    not null,
    default: false,
    note: 'Whether notifications are muted for this participant.'
  ]

  is_archived bool [
    not null,
    default: false,
    note: 'Whether this participant archived the conversation.'
  ]

  created_at timestamp [
    not null,
    default: `CURRENT_TIMESTAMP`,
    note: 'Creation timestamp.'
  ]

  updated_at timestamp [
    not null,
    default: `CURRENT_TIMESTAMP`,
    note: 'Most recent update timestamp.'
  ]

  indexes {
    (conversation_id, user_id) [
      unique,
      name: 'uq_conversation_participants_user'
    ]

    conversation_id [
      name: 'idx_conversation_participants_conversation'
    ]

    user_id [
      name: 'idx_conversation_participants_user'
    ]

    (user_id, conversation_id) [
      name: 'idx_conversation_participants_active_user',
      note: 'PostgreSQL implementation uses a partial index where left_at IS NULL.'
    ]

    last_read_message_id [
      name: 'idx_conversation_participants_last_read'
    ]
  }
}
