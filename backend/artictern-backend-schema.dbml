Table profile.connection_requests {
  Note: '''
  Stores the complete lifecycle and history of user connection requests.

  Allowed status values:
  - PENDING
  - ACCEPTED
  - REJECTED
  - CANCELLED

  Only one pending request may exist for an unordered user pair.
  This partial expression index is enforced in PostgreSQL but cannot
  be represented completely in DBML.
  '''

  id uuid [pk, not null, default: `gen_random_uuid()`]

  sender_user_id uuid [not null, note: 'User who sent the connection request.']

  receiver_user_id uuid [not null, note: 'User who received the connection request.']

  status varchar(20) [not null, default: 'PENDING', note: 'PENDING, ACCEPTED, REJECTED, or CANCELLED.']

  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  resolved_at timestamp [note: 'Set when the request is accepted, rejected, or cancelled. Null while pending.']

  indexes {
    (receiver_user_id, created_at, id) [name: 'idx_connection_requests_incoming']

    (sender_user_id, created_at, id) [name: 'idx_connection_requests_outgoing']
  }
}


Table profile.connections {
  Note: '''
  Stores accepted symmetric user connections.

  Each relationship is stored once as a canonical UUID pair:
  user_low_id < user_high_id.

  Blocking either user automatically removes the connection.
  '''

  id uuid [pk, not null, default: `gen_random_uuid()`]

  user_low_id uuid [not null, note: 'Lexicographically smaller user UUID.']

  user_high_id uuid [not null, note: 'Lexicographically larger user UUID.']

  connected_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (user_low_id, user_high_id) [unique, name: 'uq_connections_pair']

    (user_low_id, connected_at, id) [name: 'idx_connections_user_low']

    (user_high_id, connected_at, id) [name: 'idx_connections_user_high']
  }
}

