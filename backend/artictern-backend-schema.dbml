Table explore.comment_likes {
  Note: 'Stores one like per user on a comment. The associated comment like_count is maintained by a PostgreSQL trigger.'

  id uuid [
    pk,
    not null,
    default: `gen_random_uuid()`,
    note: 'Primary identifier generated by PostgreSQL.'
  ]

  comment_id uuid [
    not null,
    note: 'Comment that received the like.'
  ]

  user_id uuid [
    not null,
    note: 'Authenticated user who liked the comment.'
  ]

  created_at timestamp [
    not null,
    default: `CURRENT_TIMESTAMP`,
    note: 'Timestamp when the comment was liked.'
  ]

  indexes {
    (comment_id, user_id) [
      unique,
      name: 'uq_comment_likes_comment_user'
    ]

    (comment_id, created_at, id) [
      name: 'idx_comment_likes_comment_created_id',
      note: 'Physical PostgreSQL index uses created_at DESC and id DESC.'
    ]

    (user_id) [
      name: 'idx_comment_likes_user'
    ]
  }
}

