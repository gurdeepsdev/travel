Table poi.places {
  Note: 'Canonical points of interest used across profiles, itineraries, trips, and explore content.'
  id uuid [pk, not null, note: 'Primary identifier. Filled by: server-generated UUID.']
  city_id uuid [not null, note: 'City containing this POI.']
  region_id uuid [not null, note: 'Region containing this POI.']
  country_id uuid [not null, note: 'Country containing this POI.']
  category_id uuid [not null, note: 'Primary classification for this POI.']
  name varchar(50) [not null, note: 'POI display name.']
  description varchar(500) [note: 'POI description.']
  address varchar(300) [note: 'Street or locality address.']
  postal_code varchar(50) [note: 'Postal or ZIP code.']
  longitude float [note: 'Longitude coordinate.']
  latitude float [note: 'Latitude coordinate. Source column was spelled lattitude.']
  opening_hour rjson [note: 'Opening rjson supplied by the source. Consider time or a separate weekly-hours table for recurring schedules.']
  closing_hour rjson [note: 'Closing rjson supplied by the source. Consider time or a separate weekly-hours table for recurring schedules.']
  recommended_duration varchar(50) [note: 'Human-readable recommended visit duration.']
  booking_type varchar(50) [note: 'Booking mode or requirement. Define supported values with a CHECK or enum.']
  is_verified bool [not null, default: false, note: 'Whether this POI has been verified.']
  require_ticket bool [not null, default: false, note: 'Whether entry normally requires a ticket.']
  review_count bigint [not null, default: 0, note: 'Number of reviews used to calculate rating.']
  rating float [note: 'Aggregate rating. Add an application or database constraint for the supported range.']
  provider varchar(50) [note: 'External data provider name.']
  provider_id varchar(100) [note: 'Identifier assigned by the external provider.']
  is_closed bool [not null, default: false, note: 'Whether the POI is permanently or currently marked closed.']
  media_id uuid [note: 'Primary media asset for this POI.']
  itinerary_worthiness bool [not null, default: false, note: 'Whether the POI is considered suitable for itinerary recommendations. Source column was spelled itinery_worthiness.']
  created_at timestamptz [not null, note: 'Creation audit timestamptz. Filled by: auto.']
  updated_at timestamptz [note: 'Most recent update audit timestamptz. Filled by: auto.']

  indexes {
    (provider, provider_id) [unique]
  }
}

Table poi.currencies {
  Note: 'Currencies supported by countries, expenses, and other financial workflows.'

  id uuid [pk, not null, note: 'Primary identifier. Filled by: server-generated UUID.']

  name varchar(50) [not null, note: 'Currency name, for example Indian Rupee.']

  symbol varchar(10) [not null, note: 'Currency symbol, for example ₹, $, or €.']

  exchange_rate float [not null, note: 'Exchange rate relative to the application base currency.']

  created_at timestamptz [not null, note: 'Creation audit timestamptz. Filled automatically.']

  updated_at timestamptz [note: 'Most recent update audit timestamptz. Filled automatically.']
}

Table users.memories {
  Note: 'Private image, video, and boomerang memories saved by an authenticated user.'

  id uuid [
    pk,
    not null,
    default: `gen_random_uuid()`
  ]

  user_id uuid [
    not null,
    note: 'Owner of the private memory.'
  ]

  asset_id uuid [
    not null,
    note: 'Owned image or video stored in media.assets.'
  ]

  memory_type varchar(20) [
    not null,
    note: 'IMAGE, VIDEO, or BOOMERANG.'
  ]

  created_at timestamp [
    not null,
    default: `CURRENT_TIMESTAMP`
  ]

  indexes {
    (user_id, asset_id) [
      unique,
      name: 'uq_memories_user_asset'
    ]

    (user_id, created_at, id) [
      name: 'idx_memories_user_created_id',
      note: 'PostgreSQL uses created_at DESC and id DESC.'
    ]

    (asset_id) [
      name: 'idx_memories_asset'
    ]
  }
}

